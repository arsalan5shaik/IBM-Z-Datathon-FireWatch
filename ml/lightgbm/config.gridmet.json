{
  "grid": "../weather_elevation/data/california_grid_numeric_id.geojson",
  "elevation": "../weather_elevation/data/california_elevation_minmax_3km.csv",
  "crosswalk": "data/input/grid_id_mapping.csv",
  "erc": {"path": "data/gridmet_historical/erc_daily.csv.gz", "id_namespace": "numeric"},
  "weather": {"path": "data/gridmet_historical/weather_daily.csv.gz", "id_namespace": "numeric"},
  "vegetation": null,
  "weather_features": ["tmmx_C", "tmmn_C", "rmin_pct", "pr_mm_day", "vs_m_s"],
  "vegetation_features": [],
  "feature_units": {
    "tmmx_C": "degC",
    "tmmn_C": "degC",
    "rmin_pct": "%",
    "pr_mm_day": "mm/day",
    "vs_m_s": "m/s"
  },
  "weather_lag_days": 1,
  "target_definition": "Historical gridMET daily Energy Release Component, fuel model G (ERC-G), unitless index; environmental fire danger, not ignition probability",
  "date_convention": "gridMET daily date (MST day; boundary 07:00 UTC); weather predictors shifted back one full gridMET day",
  "validation_start": "2025-01-01",
  "test_start": "2025-07-01",
  "parameters": {
    "n_estimators": 250,
    "learning_rate": 0.05,
    "num_leaves": 15,
    "min_child_samples": 1000,
    "max_bin": 63,
    "reg_lambda": 1.0,
    "n_jobs": 4
  }
}
