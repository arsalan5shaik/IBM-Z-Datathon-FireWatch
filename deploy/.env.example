# Copy to deploy/.env; never commit real keys. Pass --env-file deploy/.env.
FIREWATCH_PLATFORM=linux/amd64
IMAGE_TAG=local
FIREWATCH_BIND_ADDRESS=127.0.0.1
FIREWATCH_PORT=8080
NASA_FIRMS_MAP_KEY=
FIRMS_REFRESH_MINUTES=15
# Chat stays blocked (403) while CHAT_PROXY_TOKEN is empty. To enable it, set a
# 32+ character token (openssl rand -hex 32) and a backend-only OpenAI key. nginx
# then acts as the trusted gateway. It does not authenticate users, so put an
# access-controlled edge (e.g. Cloudflare Access) in front of any public URL.
CHAT_PROXY_TOKEN=
OPENAI_API_KEY=
