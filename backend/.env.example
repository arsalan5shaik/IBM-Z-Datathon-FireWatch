# Copy to backend/.env. Never commit real keys.
# REPO_ROOT must be absolute if set; default is derived from the source tree.
# REPO_ROOT=/absolute/path/to/IBM-Z-Datathon-FireWatch
SHARED_DATA_DIR=shared/data
SQLITE_PATH=shared/data/firewatch.sqlite3
# Empty list denies cross-origin browser access. Use explicit origins, no trailing slash.
CORS_ORIGINS=["http://localhost:5173"]
# Canonical key for NASA FIRMS Area API. Legacy FIRMS_MAP_KEY is also accepted.
NASA_FIRMS_MAP_KEY=
LLM_API_KEY=
WEATHER_PROVIDER=open-meteo
FORECAST_HOURS=168
GRID_RESOLUTION_M=3000
# Explicit opt-in; backend and ML must never both schedule publication.
JOB_ENABLED=false
SCHEDULER_OWNER=unassigned
# JSON argv array, e.g. ["/srv/firewatch/ml/.venv/bin/python","/srv/firewatch/ml/predict.py"]
# The actual ML entry point is an integration dependency; no generator is bundled.
FORECAST_GENERATOR_CMD=
GENERATOR_TIMEOUT_SECONDS=300
GENERATOR_MAX_RETRIES=2
GENERATOR_RETRY_SECONDS=1
FORECAST_RETENTION_HOURS=24
MIN_FREE_DISK_MB=512
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10
CACHE_MAX_ENTRIES=128
ALLOW_FIXTURE_DATA=false
FORECAST_CACHE_HOURS=4
MAX_RESPONSE_CELLS=2000
PROVIDER_MAX_RETRIES=2
# Run exactly one separate FIRMS refresh owner; API startup/GET never polls NASA.
FIRMS_REFRESH_MINUTES=15
FIRMS_SOURCES=["VIIRS_NOAA20_NRT","VIIRS_NOAA21_NRT"]
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
FIRMS_MAX_HOURS=72
FIRMS_DEFAULT_LIMIT=500
FIRMS_MAX_LIMIT=2000
FIRMS_MAX_ROWS=50000
FIRMS_MAX_RESPONSE_BYTES=4000000
# Read-only reuse of the existing Census-derived California geometry.
FIRMS_BOUNDARY_PATH=frontend/public/data/ca-boundary.geojson
WEATHER_REFRESH_MINUTES=60
