# Copy to backend/.env. Never commit real keys.
# REPO_ROOT must be absolute if set; default is derived from the source tree.
# REPO_ROOT=/absolute/path/to/IBM-Z-Datathon-FireWatch
SHARED_DATA_DIR=shared/data
SQLITE_PATH=shared/data/firewatch.sqlite3
# Empty list denies cross-origin browser access. Use explicit origins, no trailing slash.
CORS_ORIGINS=["http://localhost:5173"]
FIRMS_MAP_KEY=
LLM_API_KEY=
WEATHER_PROVIDER=open-meteo
FORECAST_HOURS=168
GRID_RESOLUTION_M=3000
# Remains false until single-owner scheduling is implemented and agreed with ML.
JOB_ENABLED=false
FORECAST_GENERATOR_CMD=
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10
CACHE_MAX_ENTRIES=128
PROVIDER_MAX_RETRIES=2
FIRMS_REFRESH_MINUTES=15
WEATHER_REFRESH_MINUTES=60
